# Neon pooled connection string; never commit a real credential.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require"

APP_ENV="development"
DEBUG="false"

# jwt is the safe default. Use development_header only for isolated local work.
AUTH_MODE="jwt"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
JWT_AUDIENCE=""
JWT_ISSUER=""

# Gmail SMTP. Create a Google App Password; do not use your normal password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-16-character-google-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
EMAIL_OTP_EXPIRY_SECONDS="600"

# Single frontend origin. Do not include paths.
CORS_ORIGINS="http://localhost:8080"
