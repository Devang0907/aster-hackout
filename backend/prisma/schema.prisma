generator client {
  provider                    = "prisma-client-py"
  interface                   = "asyncio"
  recursive_type_depth        = 5
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  factory_owner
  factory_manager

  @@map("user_role")
}

enum ReportingPeriodStatus {
  draft
  submitted
  processing
  completed
  failed

  @@map("reporting_period_status")
}

enum EmissionSeverity {
  low
  medium
  high
  critical

  @@map("emission_severity")
}

enum RecommendationStatus {
  new
  viewed
  accepted
  rejected
  implemented

  @@map("recommendation_status")
}

enum PipelineRunStatus {
  queued
  running
  completed
  failed

  @@map("pipeline_run_status")
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  fullName           String            @map("full_name") @db.VarChar(150)
  email              String            @unique(map: "users_email_key") @db.VarChar(255)
  role               UserRole
  phone              String?           @db.VarChar(20)
  isActive           Boolean           @default(true) @map("is_active")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  factoriesOwned     Factory[]         @relation("FactoryOwner")
  managedFactory     Factory?          @relation("FactoryManager")
  submittedPeriods   ReportingPeriod[] @relation("ReportingPeriodSubmitter")
  simulationsCreated Simulation[]      @relation("SimulationCreator")
  auditLogs          AuditLog[]

  @@index([email], map: "users_email_idx")
  @@index([role], map: "users_role_idx")
  @@map("users")
}

model Factory {
  id                  String                 @id @default(uuid()) @db.Uuid
  ownerId             String                 @map("owner_id") @db.Uuid
  managerId           String?                @unique(map: "factories_manager_id_key") @map("manager_id") @db.Uuid
  name                String                 @db.VarChar(200)
  industryType        String                 @map("industry_type") @db.VarChar(100)
  description         String?                @db.Text
  address             String?                @db.Text
  city                String                 @db.VarChar(100)
  state               String                 @db.VarChar(100)
  country             String                 @default("India") @db.VarChar(100)
  latitude            Decimal?               @db.Decimal(10, 7)
  longitude           Decimal?               @db.Decimal(10, 7)
  employees           Int?
  productionCapacity  Decimal?               @map("production_capacity") @db.Decimal(20, 6)
  productionUnit      String?                @map("production_unit") @db.VarChar(50)
  establishedYear     Int?                   @map("established_year")
  isActive            Boolean                @default(true) @map("is_active")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner               User                   @relation("FactoryOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  manager             User?                  @relation("FactoryManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reportingPeriods    ReportingPeriod[]
  materialUsages      FactoryMaterialUsage[]
  energyUsages        EnergyUsage[]
  wasteStreams        WasteStream[]
  logistics           Logistics[]
  carbonResults       CarbonResult[]
  recommendations     Recommendation[]
  simulations         Simulation[]
  mlPipelineRuns      MlPipelineRun[]
  carbonCreditResults CarbonCreditResult[]
  auditLogs           AuditLog[]

  @@index([ownerId], map: "factories_owner_id_idx")
  @@index([managerId], map: "factories_manager_id_idx")
  @@index([industryType], map: "factories_industry_type_idx")
  @@index([city], map: "factories_city_idx")
  @@index([state], map: "factories_state_idx")
  @@map("factories")
}

model ReportingPeriod {
  id                  String                 @id @default(uuid()) @db.Uuid
  factoryId           String                 @map("factory_id") @db.Uuid
  periodStart         DateTime               @map("period_start") @db.Date
  periodEnd           DateTime               @map("period_end") @db.Date
  status              ReportingPeriodStatus @default(draft)
  submittedById       String?                @map("submitted_by_id") @db.Uuid
  submittedAt         DateTime?              @map("submitted_at") @db.Timestamptz(6)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  factory             Factory                @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy         User?                  @relation("ReportingPeriodSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  materialUsages      FactoryMaterialUsage[]
  energyUsages        EnergyUsage[]
  wasteStreams        WasteStream[]
  logistics           Logistics[]
  carbonResults       CarbonResult[]
  mlPipelineRuns      MlPipelineRun[]
  carbonCreditResults CarbonCreditResult[]

  @@unique([factoryId, periodStart, periodEnd], map: "reporting_periods_factory_dates_key")
  @@index([factoryId], map: "reporting_periods_factory_id_idx")
  @@index([status], map: "reporting_periods_status_idx")
  @@index([periodStart], map: "reporting_periods_start_idx")
  @@index([periodEnd], map: "reporting_periods_end_idx")
  @@map("reporting_periods")
}

model Material {
  id                         String                 @id @default(uuid()) @db.Uuid
  name                       String                 @db.VarChar(200)
  materialCode               String?                @unique(map: "materials_material_code_key") @map("material_code") @db.VarChar(50)
  materialType               String                 @map("material_type") @db.VarChar(100)
  category                   String?                @db.VarChar(100)
  subcategory                String?                @db.VarChar(100)
  grade                      String?                @db.VarChar(100)
  description                String?                @db.Text
  carbonFactor               Decimal?               @map("carbon_factor") @db.Decimal(20, 8)
  carbonUnit                 String?                @map("carbon_unit") @db.VarChar(50)
  carbonFactorSource         String?                @map("carbon_factor_source") @db.Text
  carbonFactorVersion        String?                @map("carbon_factor_version") @db.VarChar(50)
  recycledContentPossible    Boolean                @default(false) @map("recycled_content_possible")
  recyclable                 Boolean                @default(false)
  hazardous                  Boolean                @default(false)
  sustainabilityScore        Decimal?               @map("sustainability_score") @db.Decimal(7, 4)
  isActive                   Boolean                @default(true) @map("is_active")
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  factoryUsages              FactoryMaterialUsage[]
  alternativeFrom            MaterialAlternative[] @relation("SourceMaterial")
  alternativeTo              MaterialAlternative[] @relation("AlternativeMaterial")
  recommendationsForMaterial Recommendation[]       @relation("RecommendationMaterial")
  recommendationsAsAlternate Recommendation[]       @relation("RecommendationAlternative")

  @@index([name], map: "materials_name_idx")
  @@index([materialType], map: "materials_type_idx")
  @@map("materials")
}

model MaterialAlternative {
  id                          String   @id @default(uuid()) @db.Uuid
  materialId                  String   @map("material_id") @db.Uuid
  alternativeMaterialId       String   @map("alternative_material_id") @db.Uuid
  substitutionPercentage      Decimal? @map("substitution_percentage") @db.Decimal(7, 4)
  carbonReductionPercentage   Decimal? @map("carbon_reduction_percentage") @db.Decimal(7, 4)
  costDifferencePercentage    Decimal? @map("cost_difference_percentage") @db.Decimal(9, 4)
  availabilityScore           Decimal? @map("availability_score") @db.Decimal(7, 4)
  compatibilityScore          Decimal? @map("compatibility_score") @db.Decimal(7, 4)
  notes                       String?  @db.Text
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  material                    Material @relation("SourceMaterial", fields: [materialId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  alternativeMaterial        Material @relation("AlternativeMaterial", fields: [alternativeMaterialId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([materialId, alternativeMaterialId], map: "material_alternatives_pair_key")
  @@index([materialId], map: "material_alternatives_material_id_idx")
  @@index([alternativeMaterialId], map: "material_alternatives_alternative_id_idx")
  @@map("material_alternatives")
}

model FactoryMaterialUsage {
  id                 String          @id @default(uuid()) @db.Uuid
  factoryId          String          @map("factory_id") @db.Uuid
  reportingPeriodId  String          @map("reporting_period_id") @db.Uuid
  materialId         String          @map("material_id") @db.Uuid
  quantity           Decimal         @db.Decimal(20, 6)
  unit               String          @db.VarChar(30)
  recycledPercentage Decimal         @default(0) @map("recycled_percentage") @db.Decimal(7, 4)
  supplierName       String?         @map("supplier_name") @db.VarChar(200)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  factory            Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reportingPeriod    ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  material           Material        @relation(fields: [materialId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([factoryId], map: "factory_material_usage_factory_id_idx")
  @@index([reportingPeriodId], map: "factory_material_usage_period_id_idx")
  @@index([materialId], map: "factory_material_usage_material_id_idx")
  @@index([factoryId, reportingPeriodId], map: "factory_material_usage_factory_period_idx")
  @@map("factory_material_usage")
}

model EnergyUsage {
  id                  String          @id @default(uuid()) @db.Uuid
  factoryId           String          @map("factory_id") @db.Uuid
  reportingPeriodId   String          @map("reporting_period_id") @db.Uuid
  energyType          String          @map("energy_type") @db.VarChar(100)
  quantity            Decimal         @db.Decimal(20, 6)
  unit                String          @db.VarChar(30)
  renewablePercentage Decimal         @default(0) @map("renewable_percentage") @db.Decimal(7, 4)
  source              String?         @db.VarChar(100)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  factory             Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reportingPeriod     ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([factoryId], map: "energy_usage_factory_id_idx")
  @@index([reportingPeriodId], map: "energy_usage_period_id_idx")
  @@index([factoryId, reportingPeriodId], map: "energy_usage_factory_period_idx")
  @@map("energy_usage")
}

model WasteStream {
  id                 String          @id @default(uuid()) @db.Uuid
  factoryId          String          @map("factory_id") @db.Uuid
  reportingPeriodId  String          @map("reporting_period_id") @db.Uuid
  wasteType          String          @map("waste_type") @db.VarChar(100)
  quantity           Decimal         @db.Decimal(20, 6)
  unit               String          @db.VarChar(30)
  treatmentMethod    String?         @map("treatment_method") @db.VarChar(100)
  recycledQuantity   Decimal         @default(0) @map("recycled_quantity") @db.Decimal(20, 6)
  recoveredQuantity  Decimal         @default(0) @map("recovered_quantity") @db.Decimal(20, 6)
  disposedQuantity   Decimal         @default(0) @map("disposed_quantity") @db.Decimal(20, 6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  factory            Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reportingPeriod    ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([factoryId], map: "waste_streams_factory_id_idx")
  @@index([reportingPeriodId], map: "waste_streams_period_id_idx")
  @@index([factoryId, reportingPeriodId], map: "waste_streams_factory_period_idx")
  @@map("waste_streams")
}

model Logistics {
  id                String          @id @default(uuid()) @db.Uuid
  factoryId         String          @map("factory_id") @db.Uuid
  reportingPeriodId String          @map("reporting_period_id") @db.Uuid
  transportType     String          @map("transport_type") @db.VarChar(100)
  mode              String          @db.VarChar(50)
  distanceKm        Decimal         @map("distance_km") @db.Decimal(20, 6)
  weightTonnes      Decimal?        @map("weight_tonnes") @db.Decimal(20, 6)
  trips             Int?
  fuelType          String?         @map("fuel_type") @db.VarChar(50)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  factory           Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([factoryId], map: "logistics_factory_id_idx")
  @@index([reportingPeriodId], map: "logistics_period_id_idx")
  @@index([factoryId, reportingPeriodId], map: "logistics_factory_period_idx")
  @@map("logistics")
}

model EmissionFactor {
  id                    String    @id @default(uuid()) @db.Uuid
  category              String    @db.VarChar(100)
  activity              String    @db.VarChar(200)
  factor                Decimal   @db.Decimal(20, 8)
  unit                  String    @db.VarChar(50)
  source                String    @db.Text
  sourceUrl             String?   @map("source_url") @db.Text
  region                String?   @db.VarChar(100)
  country               String?   @db.VarChar(100)
  version               String    @db.VarChar(50)
  validFrom             DateTime? @map("valid_from") @db.Date
  validUntil            DateTime? @map("valid_until") @db.Date
  uncertaintyPercentage Decimal?  @map("uncertainty_percentage") @db.Decimal(7, 4)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category], map: "emission_factors_category_idx")
  @@index([activity], map: "emission_factors_activity_idx")
  @@index([country], map: "emission_factors_country_idx")
  @@index([region], map: "emission_factors_region_idx")
  @@index([version], map: "emission_factors_version_idx")
  @@map("emission_factors")
}

model CarbonResult {
  id                  String           @id @default(uuid()) @db.Uuid
  factoryId           String           @map("factory_id") @db.Uuid
  reportingPeriodId   String           @map("reporting_period_id") @db.Uuid
  pipelineRunId       String?          @unique(map: "carbon_results_pipeline_run_id_key") @map("pipeline_run_id") @db.Uuid
  totalCo2e           Decimal          @map("total_co2e") @db.Decimal(20, 6)
  electricityCo2e     Decimal          @default(0) @map("electricity_co2e") @db.Decimal(20, 6)
  fuelCo2e            Decimal          @default(0) @map("fuel_co2e") @db.Decimal(20, 6)
  materialCo2e        Decimal          @default(0) @map("material_co2e") @db.Decimal(20, 6)
  transportCo2e       Decimal          @default(0) @map("transport_co2e") @db.Decimal(20, 6)
  wasteCo2e           Decimal          @default(0) @map("waste_co2e") @db.Decimal(20, 6)
  renewableOffset     Decimal          @default(0) @map("renewable_offset") @db.Decimal(20, 6)
  netCo2e             Decimal          @map("net_co2e") @db.Decimal(20, 6)
  carbonIntensity     Decimal?         @map("carbon_intensity") @db.Decimal(20, 8)
  carbonIntensityUnit String?          @map("carbon_intensity_unit") @db.VarChar(100)
  calculationVersion  String           @map("calculation_version") @db.VarChar(50)
  mlModelVersion      String?          @map("ml_model_version") @db.VarChar(100)
  calculatedAt        DateTime         @default(now()) @map("calculated_at") @db.Timestamptz(6)
  factory             Factory          @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reportingPeriod     ReportingPeriod  @relation(fields: [reportingPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pipelineRun         MlPipelineRun?   @relation(fields: [pipelineRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emissionSources     EmissionSource[]
  recommendations     Recommendation[]
  simulations         Simulation[]

  @@unique([reportingPeriodId, calculationVersion], map: "carbon_results_period_version_key")
  @@index([factoryId], map: "carbon_results_factory_id_idx")
  @@index([reportingPeriodId], map: "carbon_results_period_id_idx")
  @@index([calculatedAt], map: "carbon_results_calculated_at_idx")
  @@map("carbon_results")
}

model EmissionSource {
  id                String               @id @default(uuid()) @db.Uuid
  resultId          String               @map("result_id") @db.Uuid
  sourceType        String               @map("source_type") @db.VarChar(100)
  sourceName        String               @map("source_name") @db.VarChar(200)
  sourceReferenceId String?              @map("source_reference_id") @db.Uuid
  emissionsCo2e     Decimal              @map("emissions_co2e") @db.Decimal(20, 6)
  percentage        Decimal              @db.Decimal(7, 4)
  severity          EmissionSeverity
  rank              Int
  explanation       String?              @db.Text
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  result            CarbonResult         @relation(fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recommendations   Recommendation[]

  @@unique([resultId, rank], map: "emission_sources_result_rank_key")
  @@index([resultId], map: "emission_sources_result_id_idx")
  @@index([rank], map: "emission_sources_rank_idx")
  @@map("emission_sources")
}

model Intervention {
  id                                 String           @id @default(uuid()) @db.Uuid
  name                               String           @db.VarChar(200)
  category                           String           @db.VarChar(100)
  description                        String           @db.Text
  interventionType                   String?          @map("intervention_type") @db.VarChar(100)
  applicableIndustries               Json?            @map("applicable_industries") @db.JsonB
  estimatedCostMin                   Decimal?         @map("estimated_cost_min") @db.Decimal(20, 2)
  estimatedCostMax                   Decimal?         @map("estimated_cost_max") @db.Decimal(20, 2)
  expectedCo2ReductionPercentage     Decimal?         @map("expected_co2_reduction_percentage") @db.Decimal(7, 4)
  expectedEnergyReductionPercentage  Decimal?         @map("expected_energy_reduction_percentage") @db.Decimal(7, 4)
  expectedWasteReductionPercentage   Decimal?         @map("expected_waste_reduction_percentage") @db.Decimal(7, 4)
  paybackMonthsMin                   Decimal?         @map("payback_months_min") @db.Decimal(12, 2)
  paybackMonthsMax                   Decimal?         @map("payback_months_max") @db.Decimal(12, 2)
  feasibilityScore                   Decimal?         @map("feasibility_score") @db.Decimal(7, 4)
  technologyReadiness                Decimal?         @map("technology_readiness") @db.Decimal(7, 4)
  implementationComplexity           String?          @map("implementation_complexity") @db.VarChar(50)
  createdAt                          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  recommendations                    Recommendation[]

  @@index([category], map: "interventions_category_idx")
  @@index([name], map: "interventions_name_idx")
  @@map("interventions")
}

model Recommendation {
  id                         String               @id @default(uuid()) @db.Uuid
  factoryId                  String               @map("factory_id") @db.Uuid
  resultId                   String               @map("result_id") @db.Uuid
  interventionId             String               @map("intervention_id") @db.Uuid
  materialId                 String?              @map("material_id") @db.Uuid
  alternativeMaterialId      String?              @map("alternative_material_id") @db.Uuid
  emissionSourceId           String?              @map("emission_source_id") @db.Uuid
  priority                   Int
  recommendationScore        Decimal?             @map("recommendation_score") @db.Decimal(7, 4)
  estimatedCo2Reduction      Decimal?             @map("estimated_co2_reduction") @db.Decimal(20, 6)
  estimatedCost              Decimal?             @map("estimated_cost") @db.Decimal(20, 2)
  estimatedAnnualSavings     Decimal?             @map("estimated_annual_savings") @db.Decimal(20, 2)
  paybackMonths              Decimal?             @map("payback_months") @db.Decimal(12, 2)
  feasibilityScore           Decimal?             @map("feasibility_score") @db.Decimal(7, 4)
  confidenceScore            Decimal?             @map("confidence_score") @db.Decimal(7, 4)
  aiExplanation              String?              @map("ai_explanation") @db.Text
  status                     RecommendationStatus @default(new)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  factory                    Factory              @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  result                     CarbonResult         @relation(fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  intervention               Intervention         @relation(fields: [interventionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  material                   Material?            @relation("RecommendationMaterial", fields: [materialId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  alternativeMaterial        Material?            @relation("RecommendationAlternative", fields: [alternativeMaterialId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emissionSource             EmissionSource?      @relation(fields: [emissionSourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([factoryId], map: "recommendations_factory_id_idx")
  @@index([resultId], map: "recommendations_result_id_idx")
  @@index([priority], map: "recommendations_priority_idx")
  @@index([status], map: "recommendations_status_idx")
  @@index([interventionId], map: "recommendations_intervention_id_idx")
  @@map("recommendations")
}

model Simulation {
  id                     String       @id @default(uuid()) @db.Uuid
  factoryId              String       @map("factory_id") @db.Uuid
  baseResultId           String       @map("base_result_id") @db.Uuid
  name                   String       @db.VarChar(200)
  assumptions            Json         @db.JsonB
  baselineCo2e           Decimal      @map("baseline_co2e") @db.Decimal(20, 6)
  resultingCo2e          Decimal      @map("resulting_co2e") @db.Decimal(20, 6)
  co2Reduction           Decimal      @map("co2_reduction") @db.Decimal(20, 6)
  co2ReductionPercentage Decimal      @map("co2_reduction_percentage") @db.Decimal(7, 4)
  estimatedCost          Decimal?     @map("estimated_cost") @db.Decimal(20, 2)
  estimatedSavings       Decimal?     @map("estimated_savings") @db.Decimal(20, 2)
  paybackMonths          Decimal?     @map("payback_months") @db.Decimal(12, 2)
  createdById            String       @map("created_by_id") @db.Uuid
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  factory                Factory      @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  baseResult             CarbonResult @relation(fields: [baseResultId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy              User         @relation("SimulationCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([factoryId], map: "simulations_factory_id_idx")
  @@index([baseResultId], map: "simulations_base_result_id_idx")
  @@index([createdById], map: "simulations_created_by_id_idx")
  @@map("simulations")
}

model MlPipelineRun {
  id                String            @id @default(uuid()) @db.Uuid
  factoryId         String            @map("factory_id") @db.Uuid
  reportingPeriodId String            @map("reporting_period_id") @db.Uuid
  pipelineVersion   String            @map("pipeline_version") @db.VarChar(100)
  modelVersion      String?           @map("model_version") @db.VarChar(100)
  status            PipelineRunStatus @default(queued)
  startedAt         DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(6)
  errorMessage      String?           @map("error_message") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  factory           Factory           @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reportingPeriod   ReportingPeriod   @relation(fields: [reportingPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  carbonResult      CarbonResult?

  @@index([factoryId], map: "ml_pipeline_runs_factory_id_idx")
  @@index([reportingPeriodId], map: "ml_pipeline_runs_period_id_idx")
  @@index([status], map: "ml_pipeline_runs_status_idx")
  @@map("ml_pipeline_runs")
}

model CarbonCreditResult {
  id                  String          @id @default(uuid()) @db.Uuid
  factoryId           String          @map("factory_id") @db.Uuid
  reportingPeriodId   String          @map("reporting_period_id") @db.Uuid
  grossEmissions      Decimal         @map("gross_emissions") @db.Decimal(20, 6)
  eligibleReductions  Decimal         @default(0) @map("eligible_reductions") @db.Decimal(20, 6)
  verifiedReductions  Decimal         @default(0) @map("verified_reductions") @db.Decimal(20, 6)
  carbonCredits       Decimal         @default(0) @map("carbon_credits") @db.Decimal(20, 6)
  methodology         String?         @db.VarChar(200)
  verificationStatus  String?         @map("verification_status") @db.VarChar(50)
  calculatedAt        DateTime        @default(now()) @map("calculated_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  factory             Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reportingPeriod     ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([factoryId], map: "carbon_credit_results_factory_id_idx")
  @@index([reportingPeriodId], map: "carbon_credit_results_period_id_idx")
  @@map("carbon_credit_results")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  factoryId  String?  @map("factory_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  factory    Factory? @relation(fields: [factoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId], map: "audit_logs_user_id_idx")
  @@index([factoryId], map: "audit_logs_factory_id_idx")
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@index([entityType], map: "audit_logs_entity_type_idx")
  @@index([entityId], map: "audit_logs_entity_id_idx")
  @@map("audit_logs")
}
